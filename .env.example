PORT=4317
APP_URL=http://localhost:4317
# Gerados pelo scripts/start.sh. Não compartilhe o arquivo .env.
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://watcher:CHANGE_ME@localhost:5438/watcher
REDIS_URL=redis://localhost:6388
DATA_DIR=./data
# Caminho absoluto no computador. scripts/start.sh usa a pasta media/ deste projeto.
LOCAL_MEDIA_DIR=/caminho/absoluto/para/seus/videos
LOG_LEVEL=info
# Cortes: deixe vazio para ajustar automaticamente ao número de CPUs disponíveis.
# Paralelismo aceita 1 ou 2. Threads por renderização aceitam 1 a 8.
CUTS_PARALLELISM=
CUTS_RENDER_THREADS=

# Gerado por scripts/start.sh; nunca compartilhar com o frontend.
BROWSER_AGENT_TOKEN=

# Opcional: token da extensão Playwright MCP. Também pode ser salvo em Conexões.
# É diferente de BROWSER_AGENT_TOKEN; o valor salvo no painel tem prioridade.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# IA editorial opcional: endpoint compatível com chat/completions (inclua /v1).
# Sem estas opções, a geração usa somente regras locais. Não compartilhe a chave.
TEXT_AI_BASE_URL=
TEXT_AI_MODEL=
TEXT_AI_API_KEY=
